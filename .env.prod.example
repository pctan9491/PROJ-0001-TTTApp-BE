# ======================================================================
# PRODUCTION ENVIRONMENT OVERRIDES
# Copy this file to `.env.prod` and adjust as needed.
# Loaded AFTER the base `.env` — any value here overrides `.env`.
# Default DB name: tttapp_prod
# ======================================================================

# Force production environment
DJANGO_ENV=prod

# REQUIRED: Generate a strong, unique secret key for production. DO NOT share!
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-strong-production-secret-key-here

# REQUIRED: Your production domain(s) — comma separated
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# DEBUG MUST be False in production
DJANGO_DEBUG=False

# REQUIRED: Production DB connection — ideally on a private/internal host
DB_HOST=prod-db.internal.example.com
DB_PORT=5432
DB_USER=prod_db_user
DB_PASSWORD=replace-with-strong-production-db-password

# Optional: use custom DB name instead of default "tttapp_prod"
# DB_NAME=tttapp_prod
