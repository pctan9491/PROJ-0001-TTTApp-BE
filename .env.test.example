# ======================================================================
# TEST / STAGING ENVIRONMENT OVERRIDES
# Copy this file to `.env.test` and adjust as needed.
# Loaded AFTER the base `.env` — any value here overrides `.env`.
# Default DB name: tttapp_test
# ======================================================================

# Force test environment
DJANGO_ENV=test

# REQUIRED: Generate a unique secret key for the test environment
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-test-secret-key-here

# REQUIRED: Your test/staging server hostname(s) — comma separated
DJANGO_ALLOWED_HOSTS=test.example.com,staging.example.com

# DEBUG should stay OFF in test to catch real issues
DJANGO_DEBUG=False

# If test DB lives on a different server, override these:
# DB_HOST=test-db.example.com
# DB_PORT=5432
# DB_USER=test_db_user
# DB_PASSWORD=test-db-password

# Optional: use custom DB name instead of default "tttapp_test"
# DB_NAME=tttapp_test
