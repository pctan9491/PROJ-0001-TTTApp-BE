# ======================================================================
# DEVELOPMENT ENVIRONMENT OVERRIDES
# Copy this file to `.env.dev` and adjust as needed.
# Loaded AFTER the base `.env` — any value here overrides `.env`.
# Default DB name: tttapp_dev
# ======================================================================

# You only need to put values HERE that DIFFER from the base .env.
# Common dev overrides:

# Switch to the dev env (usually matches DJANGO_ENV in base .env)
# DJANGO_ENV=dev

# Use a custom dev DB name instead of the default "tttapp_dev"
# DB_NAME=tttapp_dev

# Enable debug toolbar / verbose logging in dev
# DJANGO_DEBUG=True

# Example: dev server on a different local IP
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
