# ======================================================================
# BASE ENVIRONMENT VARIABLES — shared across all environments
# Copy this to `.env` and fill in the shared values below.
# You can then override specific values per environment using:
#   .env.dev   (loaded when DJANGO_ENV=dev)
#   .env.test  (loaded when DJANGO_ENV=test)
#   .env.prod  (loaded when DJANGO_ENV=prod)
# ======================================================================

# ----------------------------------------------------------------------
# Environment selector: dev | test | prod
# Controls default DB name (tttapp_dev / tttapp_test / tttapp_prod)
# and default DEBUG / ALLOWED_HOSTS values.
# ----------------------------------------------------------------------
DJANGO_ENV=dev

# ----------------------------------------------------------------------
# Django secret key — REQUIRED for test/prod, has unsafe default in dev
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ----------------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-real-secret-key-here

# ----------------------------------------------------------------------
# Debug mode — defaults: dev=True, test=False, prod=False
# ----------------------------------------------------------------------
DJANGO_DEBUG=True

# ----------------------------------------------------------------------
# Allowed hosts (comma-separated) — defaults to localhost,127.0.0.1 in dev
# Required for test / prod
# ----------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------
# PostgreSQL credentials (shared across DBs on the same server)
# DB_NAME defaults to "tttapp_${DJANGO_ENV}" — override in .env.<env> if needed
# ----------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional: override default DB name (tttapp_<env>)
# DB_NAME=tttapp_custom_name
